# AI QA Tester — Environment Variables
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# On Vercel/hosting: set these in the dashboard (Environment Variables), not in files.

# Site login (HTTP Basic Auth) — locks the WHOLE site behind the browser's
# native "sign in" popup. Browsers then send credentials automatically.
# Set BOTH to enable. Also set these same two values in the hosting
# dashboard (e.g. Vercel → Environment Variables), never in any file.
AUTH_USER=
AUTH_PASS=

# ...or lock ONLY /api/* behind the X-API-Key header instead (UI stays open).
# Leave empty ONLY for local-only use. Browsers use the matching key from
# Settings → Access Login (browser localStorage, never in the repo).
API_KEY=

# NVIDIA / OpenAI-compatible Cloud API (optional — only if ai_provider=cloud).
# Highest priority: env > config.json > database. Prefer env for deploys.
CLOUD_API_KEY=
CLOUD_BASE_URL=https://integrate.api.nvidia.com/v1
CLOUD_MODEL=meta/llama-3.2-11b-vision-instruct

# Anthropic API (optional — only if used directly).
ANTHROPIC_API_KEY=

# Ollama (local — no secrets needed).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
